{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "width",
    "height",
    "coordinate_origin",
    "coordinate_units",
    "rooms",
    "walls",
    "doors",
    "walkable_areas"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "width": {
      "type": "integer",
      "minimum": 1
    },
    "height": {
      "type": "integer",
      "minimum": 1
    },
    "coordinate_origin": {
      "const": "top-left"
    },
    "coordinate_units": {
      "const": "pixels"
    },
    "rooms": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "category",
          "bbox",
          "confidence"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "enum": [
              "bathroom",
              "studySpace",
              "exit",
              "entrance",
              "elevator",
              "stairs",
              "classroom",
              "auditorium",
              "food",
              "office",
              "accessibilityService",
              "landmark",
              "other"
            ]
          },
          "bbox": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 4,
            "maxItems": 4
          },
          "confidence": {
            "$ref": "#/$defs/confidence"
          },
          "rotation_deg": {
            "type": "number",
            "minimum": -180,
            "maximum": 180,
            "description": "Clockwise degrees about the center of bbox; omitted means zero. bbox is the unrotated local rectangle."
          }
        }
      }
    },
    "walls": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/area"
      }
    },
    "walkable_areas": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/area"
      }
    },
    "doors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "room_id",
          "point",
          "confidence"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "room_id": {
            "$ref": "#/$defs/id"
          },
          "point": {
            "$ref": "#/$defs/point"
          },
          "confidence": {
            "$ref": "#/$defs/confidence"
          }
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "point": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 2,
      "maxItems": 2
    },
    "area": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "polygon",
        "confidence"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "polygon": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/point"
          },
          "minItems": 3
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        }
      }
    }
  }
}
